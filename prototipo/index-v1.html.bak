<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>CãoMetria — Protótipo</title>
<style>
  :root{
    --paper:#F4F4F0; --surface:#FFFFFF; --surface-2:#FAFAF7;
    --ink:#191B1F; --ink-soft:#565A61; --ink-faint:#9A9EA4;
    --line:#E4E4DE; --line-strong:#D2D2CB;
    --brand:#0B5D5D; --brand-ink:#083F3F; --brand-tint:#E7F0F0;
    --green:#2E9E5B; --green-tint:#E6F4EC;
    --amber:#C98A0E; --amber-tint:#FBF1DD;
    --red:#CE4141; --red-tint:#FBE9E9;
    --shadow:0 1px 2px rgba(20,22,26,.05), 0 8px 24px rgba(20,22,26,.08);
    --shadow-lg:0 12px 40px rgba(20,22,26,.16);
    --font:"Segoe UI",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;
    --mono:"Consolas","SF Mono",ui-monospace,monospace;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --paper:#0F1113; --surface:#17191C; --surface-2:#1C1F22;
      --ink:#ECEDEA; --ink-soft:#A4A9AE; --ink-faint:#656A6F;
      --line:#2A2D31; --line-strong:#3A3E43;
      --brand:#34AFAF; --brand-ink:#8FD9D9; --brand-tint:#123536;
      --green:#46C07A; --green-tint:#12331F;
      --amber:#E4AE4A; --amber-tint:#33280F;
      --red:#E56A6A; --red-tint:#331616;
    }
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#22242A;font-family:var(--font);color:var(--ink);-webkit-font-smoothing:antialiased;
    display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
  @media (max-width:520px){body{padding:0;background:var(--paper)}}

  /* Phone frame */
  .phone{
    width:400px;height:840px;max-height:100vh;background:var(--paper);position:relative;overflow:hidden;
    border-radius:38px;box-shadow:var(--shadow-lg);display:flex;flex-direction:column;
    border:1px solid var(--line);
  }
  @media (max-width:520px){.phone{width:100vw;height:100vh;border-radius:0;border:none}}

  .app-header{
    padding:22px 20px 14px;display:flex;align-items:center;justify-content:space-between;
    background:var(--surface);border-bottom:1px solid var(--line);flex:none;z-index:5;
  }
  .app-header .brand{display:flex;align-items:center;gap:10px}
  .logo{width:32px;height:32px;border-radius:9px;background:var(--brand);display:grid;place-items:center;flex:none}
  .logo svg{width:19px;height:19px}
  .app-header .nm{font-weight:800;font-size:16px;letter-spacing:-.01em}
  .app-header .clock{font-family:var(--mono);font-size:12px;color:var(--ink-faint);display:flex;align-items:center;gap:6px}
  .bell{width:38px;height:38px;border-radius:10px;border:1px solid var(--line);background:var(--surface);
    display:grid;place-items:center;cursor:pointer;color:var(--ink-soft);position:relative}
  .bell:hover{color:var(--brand);border-color:var(--brand)}
  .bell .dot{position:absolute;top:7px;right:8px;width:8px;height:8px;border-radius:50%;background:var(--red);border:2px solid var(--surface)}

  /* Screen area */
  .screen{flex:1;overflow-y:auto;overflow-x:hidden;padding:20px 18px 110px;-webkit-overflow-scrolling:touch}
  .screen::-webkit-scrollbar{width:0}

  h1{font-size:26px;font-weight:800;letter-spacing:-.02em}
  .sub{color:var(--ink-soft);font-size:14px}
  .eyebrow{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--ink-faint);font-weight:600}

  /* Filter chips */
  .filters{display:flex;gap:8px;margin:18px 0 6px;overflow-x:auto;padding-bottom:4px}
  .filters::-webkit-scrollbar{height:0}
  .chip{font-size:13px;font-weight:600;padding:8px 14px;border-radius:99px;border:1px solid var(--line);
    background:var(--surface);color:var(--ink-soft);cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px}
  .chip.active{background:var(--brand);border-color:var(--brand);color:#fff}
  .chip .cnt{font-family:var(--mono);font-size:11px;opacity:.8}
  .dotmark{width:9px;height:9px;border-radius:50%;flex:none}
  .dotmark.g{background:var(--green)}.dotmark.a{background:var(--amber)}.dotmark.r{background:var(--red)}

  /* Attention banner */
  .attn{display:flex;align-items:center;gap:12px;background:var(--amber-tint);border:1px solid var(--amber);
    border-radius:13px;padding:13px 15px;margin:14px 0 4px;cursor:pointer}
  .attn .ai{width:32px;height:32px;border-radius:9px;background:var(--amber);color:#fff;display:grid;place-items:center;flex:none}
  .attn .ai svg{width:17px;height:17px}
  .attn .at{font-weight:700;font-size:13.5px;color:var(--ink)}
  .attn .ad{font-size:12px;color:var(--ink-soft)}

  /* Pet card */
  .pet-list{display:flex;flex-direction:column;gap:10px;margin-top:14px}
  .pet-card{display:grid;grid-template-columns:auto 1fr auto;gap:13px;align-items:center;
    background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:13px 15px;
    border-left-width:4px;cursor:pointer;box-shadow:var(--shadow);transition:transform .1s}
  .pet-card:active{transform:scale(.985)}
  .pet-card.g{border-left-color:var(--green)}.pet-card.a{border-left-color:var(--amber)}.pet-card.r{border-left-color:var(--red)}
  .pet-card .av{width:42px;height:42px;border-radius:50%;background:var(--brand-tint);display:grid;place-items:center;font-size:22px;flex:none}
  .pet-card .pn{font-weight:700;font-size:16px}
  .pet-card .pi{font-size:12.5px;color:var(--ink-soft);margin-top:2px;line-height:1.35}
  .pet-card .right{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
  .badge{font-family:var(--mono);font-size:10px;padding:4px 9px;border-radius:99px;white-space:nowrap;text-transform:lowercase;letter-spacing:.03em}
  .badge.g{background:var(--green-tint);color:var(--green)}.badge.a{background:var(--amber-tint);color:var(--amber)}.badge.r{background:var(--red-tint);color:var(--red)}
  .next-task{font-family:var(--mono);font-size:11px;color:var(--ink-faint);display:flex;align-items:center;gap:4px}
  .next-task.late{color:var(--red);font-weight:700}

  .empty{text-align:center;color:var(--ink-faint);padding:60px 20px;font-size:14px}

  /* Detail */
  .back{display:inline-flex;align-items:center;gap:7px;color:var(--ink-soft);font-size:13.5px;font-weight:600;
    cursor:pointer;margin-bottom:16px;background:none;border:none;font-family:inherit}
  .back:hover{color:var(--brand)}
  .pet-head{display:flex;align-items:center;gap:16px;margin-bottom:8px}
  .pet-head .av{width:64px;height:64px;border-radius:50%;background:var(--brand-tint);display:grid;place-items:center;font-size:34px;flex:none}
  .pet-head .pn{font-size:24px;font-weight:800;letter-spacing:-.01em}
  .pet-head .pr{font-size:13px;color:var(--ink-soft);margin-top:2px}
  .collar-line{display:inline-flex;align-items:center;gap:8px;margin-top:8px;font-size:12.5px;font-weight:600}
  .puck{width:18px;height:18px;border-radius:50%;box-shadow:inset 0 0 0 3px rgba(255,255,255,.3)}
  .puck.g{background:var(--green)}.puck.a{background:var(--amber)}.puck.r{background:var(--red)}

  .react-banner{display:flex;gap:12px;align-items:flex-start;background:var(--red-tint);border:1px solid var(--red);
    border-radius:13px;padding:14px 16px;margin:18px 0}
  .react-banner svg{flex:none;color:var(--red);margin-top:1px}
  .react-banner .rt{font-weight:700;font-size:13.5px;color:var(--ink)}
  .react-banner .rd{font-size:12.5px;color:var(--ink-soft);margin-top:3px;line-height:1.4}

  .section-t{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--ink-faint);
    font-weight:600;margin:24px 0 12px}
  .tasks{display:flex;flex-direction:column;gap:9px}
  .task{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;background:var(--surface);
    border:1px solid var(--line);border-radius:12px;padding:13px 14px}
  .task .ti{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;flex:none;background:var(--surface-2)}
  .task .tl{font-weight:600;font-size:14px}
  .task .th{font-family:var(--mono);font-size:12px;color:var(--ink-soft);margin-top:1px}
  .task.done .tl{color:var(--ink-faint)}
  .task.done .th{color:var(--green)}
  .check-btn{width:30px;height:30px;border-radius:50%;border:2px solid var(--line-strong);background:transparent;cursor:pointer;
    display:grid;place-items:center;flex:none;color:transparent;transition:all .15s}
  .check-btn:hover{border-color:var(--brand)}
  .check-btn.done{background:var(--green);border-color:var(--green);color:#fff}

  .info-block{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:10px}
  .info-block .il{font-size:12px;color:var(--ink-faint);font-weight:600;margin-bottom:4px}
  .info-block .iv{font-size:14px;color:var(--ink);line-height:1.5}
  .tutor{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}
  .tutor:last-child{border-bottom:none}
  .tutor .tn{font-weight:600;font-size:14px}
  .tutor .tr{font-size:12px;color:var(--ink-soft)}
  .tutor .call{width:34px;height:34px;border-radius:9px;border:1px solid var(--line);background:var(--surface-2);
    display:grid;place-items:center;color:var(--brand);cursor:pointer;text-decoration:none}
  .em-tag{font-family:var(--mono);font-size:9px;background:var(--red-tint);color:var(--red);padding:2px 6px;border-radius:5px;margin-left:6px;letter-spacing:.03em}

  /* Forms */
  .field{margin-bottom:16px}
  .field label{display:block;font-size:12.5px;color:var(--ink-soft);font-weight:600;margin-bottom:6px}
  .field input,.field select{width:100%;padding:12px 14px;border-radius:11px;
    border:1px solid var(--line);background:var(--surface);color:var(--ink);font-family:inherit;font-size:15px}
  .field input:focus,.field select:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-tint)}
  .field{margin-bottom:16px}
  .row2{display:flex;gap:12px}
  .row2 .field{flex:1;min-width:0}
  .nested{background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:15px 16px 4px;margin:-4px 0 14px}
  .nested .field label{font-size:12px}
  .tutor-card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .tutor-idx{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--brand);font-weight:700}
  .tutor-remove{background:none;border:none;color:var(--red);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;padding:2px 4px}
  .tutor-remove:hover{text-decoration:underline}
  .hora-row{display:flex;gap:8px;align-items:center;margin-bottom:8px}
  .hora-row input{flex:1}
  .hora-remove{width:44px;height:44px;border:1px solid var(--line);background:var(--surface);border-radius:11px;
    color:var(--red);cursor:pointer;font-size:20px;line-height:1;flex:none;display:grid;place-items:center}
  .hora-remove:hover{border-color:var(--red)}
  .add-hora{background:none;border:none;color:var(--brand);font-weight:600;font-size:13px;cursor:pointer;
    font-family:inherit;padding:4px 0 2px;display:inline-flex;align-items:center;gap:6px}
  .add-hora svg{width:14px;height:14px}
  .toggle-row{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);
    border:1px solid var(--line);border-radius:12px;margin-bottom:12px}
  .toggle-row .tt{font-weight:600;font-size:14px}
  .toggle-row .td{font-size:12px;color:var(--ink-faint);margin-top:2px}
  .switch{width:46px;height:27px;border-radius:99px;background:var(--line-strong);position:relative;cursor:pointer;flex:none;transition:background .2s}
  .switch.on{background:var(--brand)}
  .switch::after{content:"";position:absolute;top:3px;left:3px;width:21px;height:21px;border-radius:50%;background:#fff;transition:left .2s}
  .switch.on::after{left:22px}
  .sub-fields{padding:2px 2px 6px;margin-bottom:8px}
  .add-btn{width:100%;padding:12px;border-radius:11px;border:1.5px dashed var(--line-strong);background:transparent;
    color:var(--brand);font-weight:600;font-size:13.5px;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px}
  .add-btn svg{width:16px;height:16px}
  .collar-preview{display:flex;align-items:center;gap:14px;padding:16px;border-radius:14px;margin:18px 0;
    background:var(--surface-2);border:1px solid var(--line)}
  .collar-preview .big-puck{width:44px;height:44px;border-radius:50%;flex:none;box-shadow:inset 0 0 0 6px rgba(255,255,255,.25);transition:background .3s}
  .collar-preview .cpt{font-size:12px;color:var(--ink-faint);font-weight:600}
  .collar-preview .cpv{font-weight:800;font-size:17px;margin-top:1px}

  .btn-primary{width:100%;padding:15px;border-radius:12px;border:none;background:var(--brand);color:#fff;
    font-weight:700;font-size:15px;cursor:pointer;font-family:inherit;margin-top:8px}
  .btn-primary:active{opacity:.9}
  .btn-secondary{width:100%;padding:14px;border-radius:12px;border:1px solid var(--line-strong);background:var(--surface);
    color:var(--ink);font-weight:600;font-size:15px;cursor:pointer;font-family:inherit;margin-top:10px}

  /* Check-in */
  .checkin-pick{display:flex;flex-direction:column;gap:10px;margin-top:16px}
  .instruct{text-align:center;padding:20px 10px}
  .instruct .big-collar{width:120px;height:120px;border-radius:50%;margin:10px auto 22px;
    box-shadow:inset 0 0 0 16px rgba(255,255,255,.22),var(--shadow);display:grid;place-items:center}
  .instruct .big-collar svg{width:52px;height:52px;color:rgba(255,255,255,.92)}
  .instruct .il1{font-size:14px;color:var(--ink-soft)}
  .instruct .il2{font-size:24px;font-weight:800;letter-spacing:-.01em;margin:6px 0 4px;line-height:1.2}
  .instruct .il2 .cc{padding:0 4px}
  .instruct .appt{font-size:13.5px;color:var(--ink-soft);background:var(--surface);border:1px solid var(--line);
    border-radius:12px;padding:14px;margin:18px 0 6px;line-height:1.5}

  /* Bottom nav */
  .navbar{position:absolute;bottom:16px;left:16px;right:16px;height:66px;background:var(--surface);
    border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);display:flex;align-items:center;
    justify-content:space-around;padding:0 10px;z-index:10}
  .nav-item{display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;cursor:pointer;
    color:var(--ink-faint);font-family:inherit;font-size:10px;font-weight:600;padding:8px 14px;flex:1}
  .nav-item svg{width:23px;height:23px}
  .nav-item.active{color:var(--brand)}
  .nav-center{margin-top:-36px}
  .nav-center .circle{width:58px;height:58px;border-radius:50%;background:var(--brand);color:#fff;display:grid;place-items:center;
    box-shadow:0 6px 18px rgba(11,93,93,.4);border:4px solid var(--paper)}
  .nav-center .circle svg{width:26px;height:26px}
  .nav-center .lbl{margin-top:5px;color:var(--brand)}

  /* Modal / alert */
  .overlay{position:absolute;inset:0;background:rgba(10,12,14,.5);z-index:50;display:none;align-items:flex-end;justify-content:center;
    animation:fade .2s ease}
  .overlay.show{display:flex}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  @keyframes slideup{from{transform:translateY(30px);opacity:.6}to{transform:none;opacity:1}}
  .alert-sheet{width:100%;background:var(--surface);border-radius:24px 24px 0 0;padding:26px 22px 24px;animation:slideup .28s cubic-bezier(.2,.8,.2,1)}
  .alert-sheet .grip{width:38px;height:4px;border-radius:99px;background:var(--line-strong);margin:0 auto 20px}
  .alert-icon{width:60px;height:60px;border-radius:16px;background:var(--red);color:#fff;display:grid;place-items:center;margin:0 auto 16px}
  .alert-icon svg{width:32px;height:32px}
  .alert-sheet h2{text-align:center;font-size:21px;font-weight:800;letter-spacing:-.01em}
  .alert-sheet .asub{text-align:center;color:var(--ink-soft);font-size:14px;margin-top:6px}
  .alert-detail{background:var(--red-tint);border-radius:14px;padding:16px;margin:20px 0;text-align:center}
  .alert-detail .amed{font-weight:800;font-size:17px}
  .alert-detail .adose{font-size:13.5px;color:var(--ink-soft);margin-top:3px}
  .alert-detail .atime{font-family:var(--mono);font-size:12px;color:var(--red);font-weight:700;margin-top:8px}

  /* Toast */
  .toast{position:absolute;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);z-index:60;
    background:var(--ink);color:var(--paper);padding:12px 20px;border-radius:12px;font-size:13.5px;font-weight:600;
    box-shadow:var(--shadow-lg);opacity:0;transition:all .3s;pointer-events:none;display:flex;align-items:center;gap:9px;white-space:nowrap}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  .toast svg{color:var(--green)}

  .fade-in{animation:fadein .3s ease}
  @keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="phone">
  <div class="app-header">
    <div class="brand">
      <div class="logo"><svg viewBox="0 0 24 24" fill="none"><circle cx="5.6" cy="9.4" r="2.6" fill="#fff"/><circle cx="12" cy="6" r="2.9" fill="#fff"/><circle cx="18.4" cy="9.4" r="2.6" fill="#fff"/><path d="M12 10.6c-3.7 0-6.4 2.7-6.4 5.5 0 2.4 2.9 3.5 6.4 3.5s6.4-1.1 6.4-3.5c0-2.8-2.7-5.5-6.4-5.5z" fill="#fff"/></svg></div>
      <span class="nm">CãoMetria</span>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <span class="clock" id="clock">14:00</span>
      <button class="bell" id="bell" title="Simular alarme de medicação" onclick="fireAlert()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="dot" id="bellDot"></span>
      </button>
    </div>
  </div>

  <div class="screen" id="screen"></div>

  <nav class="navbar" id="navbar"></nav>

  <div class="overlay" id="overlay"></div>
  <div class="toast" id="toast"></div>
</div>

<script>
/* ============ DADOS ============ */
var CUIDADOR = "Ana";
var AGORA = "14:00";

function C(hora){ return {hora:hora, done:false, at:null, by:null}; }
function M(nome,dose,hora){ return {nome:nome, dose:dose, hora:hora, done:false, at:null, by:null}; }

var pets = [
  { id:"bila", nome:"Bila", emoji:"🐶", raca:"SRD · 3 anos", present:true,
    reativo:false, dietaRacao:null, comidas:[], alergia:null, meds:[],
    tutores:[{nome:"Marina Alves", rel:"Tutora", emerg:true, tel:"11 99999-0001"}] },

  { id:"nina", nome:"Nina", emoji:"🐩", raca:"Poodle · 5 anos", present:true,
    reativo:false, dietaRacao:"Ração sem grãos", dietaPorcao:"200g", comidas:[C("12:00")], alergia:"Frango",
    meds:[M("Apoquel 5mg","1 comprimido","14:00")],
    tutores:[{nome:"Carlos Dias", rel:"Tutor", emerg:true, tel:"11 99999-0002"},
             {nome:"Beatriz Dias", rel:"Tutora · guarda compartilhada", emerg:false, tel:"11 99999-0003"}] },

  { id:"thor", nome:"Thor", emoji:"🐕‍🦺", raca:"Pastor Alemão · 4 anos", present:true,
    reativo:true, obs:"Reativo a outros machos. Isolar do grupo. Manejo com guia curta e aproximação calma.",
    dietaRacao:null, comidas:[], alergia:null, meds:[],
    tutores:[{nome:"Rafael Souza", rel:"Tutor", emerg:true, tel:"11 99999-0004"}] },

  { id:"mel", nome:"Mel", emoji:"🦮", raca:"Golden · 2 anos", present:false,
    reativo:false, dietaRacao:"Ração", dietaPorcao:"250g", comidas:[C("08:00"),C("16:00")], alergia:null,
    meds:[M("Vermífugo","1 comprimido","09:00"),M("Vermífugo","1 comprimido","21:00")],
    tutores:[{nome:"Júlia Reis", rel:"Tutora", emerg:true, tel:"11 99999-0005"}] },

  { id:"zeca", nome:"Zeca", emoji:"🐕", raca:"Beagle · 6 anos", present:false,
    reativo:false, dietaRacao:null, comidas:[], alergia:null, meds:[],
    tutores:[{nome:"Pedro Lima", rel:"Tutor", emerg:true, tel:"11 99999-0006"}] }
];

/* ============ LÓGICA ============ */
function corDoPet(p){
  if(p.reativo) return "r";
  if((p.meds && p.meds.length) || (p.comidas && p.comidas.length) || p.alergia) return "a";
  return "g";
}
function nomeCor(c){ return c==="r"?"vermelha":c==="a"?"amarela":"verde"; }

function tarefasDoPet(p){
  var ts=[];
  var dietaLabel=[p.dietaRacao,p.dietaPorcao].filter(Boolean).join(" · ");
  (p.comidas||[]).forEach(function(c,i){
    ts.push({tipo:"comida", label:"Alimentação"+(dietaLabel?" — "+dietaLabel:""), hora:c.hora,
      done:c.done, at:c.at, by:c.by, ref:"comida"+i});
  });
  (p.meds||[]).forEach(function(m,i){
    ts.push({tipo:"med", label:m.nome+" · "+m.dose, hora:m.hora, done:m.done, at:m.at, by:m.by, ref:"med"+i});
  });
  ts.sort(function(a,b){return a.hora<b.hora?-1:1;});
  return ts;
}
function proximaTarefa(p){
  var ts=tarefasDoPet(p).filter(function(t){return !t.done;});
  return ts.length?ts[0]:null;
}
function horasPend(items){ var h=(items||[]).filter(function(x){return !x.done;}).map(function(x){return x.hora;}); return h; }
function subtituloPet(p){
  var parts=[];
  if(p.reativo) parts.push("reativo · isolar");
  if(p.meds && p.meds.length) parts.push(p.meds.length>1 ? ("remédio "+p.meds.length+"x") : ("remédio "+p.meds[0].hora));
  if(p.comidas && p.comidas.length) parts.push(p.comidas.length>1 ? ("comida "+p.comidas.length+"x") : "comida "+p.comidas[0].hora);
  if(p.alergia) parts.push("alergia: "+p.alergia.toLowerCase());
  return parts.length?parts.join(" · "):"sem apontamentos";
}
function petById(id){ return pets.filter(function(p){return p.id===id;})[0]; }

/* ============ ÍCONES ============ */
var IC = {
  home:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>',
  plus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
  checkin:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>',
  paw:'<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5.6" cy="9.4" r="2.6"/><circle cx="12" cy="6" r="2.9"/><circle cx="18.4" cy="9.4" r="2.6"/><path d="M12 10.6c-3.7 0-6.4 2.7-6.4 5.5 0 2.4 2.9 3.5 6.4 3.5s6.4-1.1 6.4-3.5c0-2.8-2.7-5.5-6.4-5.5z"/></svg>',
  food:'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7a3 3 0 0 0 3 3v10M6 2v7M4.5 2v7M15 2c-1.5 1.5-2 4-2 6s.5 4 2 5v8"/></svg>',
  pill:'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5a5 5 0 0 1-7-7l6-6a5 5 0 0 1 7 7z"/><path d="M8.5 8.5l7 7"/></svg>',
  phone:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>',
  alert:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5a5 5 0 0 1-7-7l6-6a5 5 0 0 1 7 7z"/><path d="M8.5 8.5l7 7"/></svg>',
  warn:'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.3 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.3a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>',
  check:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
  back:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>',
  clock:'<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'
};

/* ============ ESTADO / ROTA ============ */
var state = { screen:"home", petId:null, filter:"all", checkinPet:null,
  form:{ dieta:false, med:false, reativo:false, nome:"", raca:"", idade:"",
    tutores:[{nome:"",rel:"",tel:""}],
    dietaRacao:"", dietaPorcao:"", dietaHoras:["12:00"], medNome:"", medDose:"", medHoras:["14:00"], reativoObs:"" } };

function nav(screen, opts){
  opts=opts||{};
  state.screen=screen;
  if(opts.petId!==undefined) state.petId=opts.petId;
  render();
  document.getElementById("screen").scrollTop=0;
}

/* ============ RENDER ============ */
function render(){
  var s=document.getElementById("screen");
  var html="";
  if(state.screen==="home") html=renderHome();
  else if(state.screen==="detail") html=renderDetail();
  else if(state.screen==="cadastro") html=renderCadastro();
  else if(state.screen==="checkin") html=renderCheckin();
  else if(state.screen==="checkin-confirm") html=renderCheckinConfirm();
  s.innerHTML='<div class="fade-in">'+html+'</div>';
  renderNav();
}

function renderHome(){
  var presentes=pets.filter(function(p){return p.present;});
  var counts={all:presentes.length,g:0,a:0,r:0};
  presentes.forEach(function(p){counts[corDoPet(p)]++;});
  var lista=presentes.filter(function(p){return state.filter==="all"||corDoPet(p)===state.filter;});
  var ordem={r:0,a:1,g:2};
  lista.sort(function(a,b){
    var d=ordem[corDoPet(a)]-ordem[corDoPet(b)];
    if(d!==0) return d;
    var ta=proximaTarefa(a), tb=proximaTarefa(b);
    if(ta&&tb) return ta.hora<tb.hora?-1:1;
    return ta?-1:(tb?1:0);
  });

  // banner de atenção: medicação pendente
  var pend=[];
  presentes.forEach(function(p){ (p.meds||[]).forEach(function(m){ if(!m.done) pend.push({p:p,m:m}); }); });
  var banner="";
  if(pend.length){
    banner='<div class="attn" onclick="fireAlert()"><div class="ai">'+IC.alert+'</div>'
      +'<div><div class="at">'+pend.length+(pend.length>1?" medicações pendentes":" medicação pendente")+' hoje</div>'
      +'<div class="ad">toque para ver o alerta de '+pend[0].p.nome+' ('+pend[0].m.hora+')</div></div></div>';
  }

  var chips='<div class="filters">'
    +chip("all","Todos",counts.all,null)
    +chip("g","",counts.g,"g")
    +chip("a","",counts.a,"a")
    +chip("r","",counts.r,"r")
    +'</div>';

  var cards="";
  if(lista.length===0){
    cards='<div class="empty">Nenhum pet nesse filtro.</div>';
  } else {
    lista.forEach(function(p){
      var c=corDoPet(p);
      var nt=proximaTarefa(p);
      var late = nt && nt.hora<=AGORA;
      var ntHtml = nt ? '<div class="next-task'+(late?' late':'')+'">'+IC.clock+' '+(late?"agora · ":"")+nt.hora+'</div>' : '';
      cards+='<div class="pet-card '+c+'" onclick="nav(\'detail\',{petId:\''+p.id+'\'})">'
        +'<div class="av">'+p.emoji+'</div>'
        +'<div><div class="pn">'+p.nome+'</div><div class="pi">'+subtituloPet(p)+'</div></div>'
        +'<div class="right"><span class="badge '+c+'">'+nomeCor(c)+'</span>'+ntHtml+'</div>'
        +'</div>';
    });
  }

  return '<div class="eyebrow">Hoje · '+AGORA+'</div>'
    +'<h1 style="margin-top:6px">'+presentes.length+' pets presentes</h1>'
    +'<div class="sub" style="margin-top:4px">Segurança primeiro — reativos no topo.</div>'
    +chips+banner+'<div class="pet-list">'+cards+'</div>';
}
function chip(key,label,count,dot){
  var active=state.filter===key?" active":"";
  var d=dot?'<span class="dotmark '+dot+'"></span>':'';
  var l=label||"";
  return '<button class="chip'+active+'" title="'+(dot?nomeCor(dot):"todos")+'" onclick="setFilter(\''+key+'\')">'+d+(l?'<span>'+l+'</span>':'')+'<span class="cnt">'+count+'</span></button>';
}
function setFilter(f){ state.filter=f; render(); }

function renderDetail(){
  var p=petById(state.petId);
  var c=corDoPet(p);
  var ts=tarefasDoPet(p);

  var reactBanner = p.reativo
    ? '<div class="react-banner">'+IC.warn+'<div><div class="rt">Reativo — isolar do grupo</div><div class="rd">'+(p.obs||"")+'</div></div></div>'
    : '';

  var tasksHtml="";
  if(ts.length){
    ts.forEach(function(t){
      var icon=t.tipo==="med"?IC.pill:IC.food;
      var meta = t.done ? ('✓ '+t.at+' · por '+t.by) : t.hora;
      tasksHtml+='<div class="task'+(t.done?" done":"")+'">'
        +'<div class="ti" style="color:'+(t.tipo==="med"?"var(--red)":"var(--amber)")+'">'+icon+'</div>'
        +'<div><div class="tl">'+t.label+'</div><div class="th">'+meta+'</div></div>'
        +'<button class="check-btn'+(t.done?" done":"")+'" onclick="toggleTask(\''+p.id+'\',\''+t.ref+'\')">'+IC.check+'</button>'
        +'</div>';
    });
  } else {
    tasksHtml='<div class="info-block"><div class="iv" style="color:var(--ink-faint)">Nenhuma tarefa agendada para hoje.</div></div>';
  }

  var temDieta = (p.comidas&&p.comidas.length)||p.alergia;
  var racaoTxt=[p.dietaRacao,p.dietaPorcao].filter(Boolean).join(" · ")||"—";
  var dietaTxt = racaoTxt + (p.comidas&&p.comidas.length?" · "+p.comidas.map(function(c){return c.hora;}).join(", "):"")
    + (p.alergia?'<br><span style="color:var(--red)">Alergia: '+p.alergia+'</span>':"");
  var dietaBlock = temDieta ? infoBlock("Dieta", dietaTxt) : "";
  var medBlock = (p.meds&&p.meds.length) ? infoBlock("Medicação", p.meds.map(function(m){return m.nome+" · "+m.dose+" · "+m.hora;}).join("<br>")) : "";
  var compBlock = p.reativo ? infoBlock("Comportamento", p.obs||"Reativo") : infoBlock("Comportamento","Sem apontamentos");

  var tutoresHtml=p.tutores.map(function(t){
    return '<div class="tutor"><div><div class="tn">'+t.nome+(t.emerg?'<span class="em-tag">emergência</span>':"")+'</div>'
      +'<div class="tr">'+t.rel+'</div></div>'
      +'<a class="call" href="tel:'+t.tel.replace(/\s/g,"")+'" onclick="toast(\'Ligando para '+t.nome+'\')">'+IC.phone+'</a></div>';
  }).join("");

  return '<button class="back" onclick="nav(\'home\')">'+IC.back+' Painel do dia</button>'
    +'<div class="pet-head"><div class="av">'+p.emoji+'</div>'
    +'<div><div class="pn">'+p.nome+'</div><div class="pr">'+p.raca+'</div>'
    +'<div class="collar-line"><span class="puck '+c+'"></span>Coleira '+nomeCor(c)+'</div></div></div>'
    +reactBanner
    +'<div class="section-t">Tarefas de hoje</div><div class="tasks">'+tasksHtml+'</div>'
    +'<div class="section-t">Prontuário</div>'+dietaBlock+medBlock+compBlock
    +'<div class="section-t">Tutores · contatos</div><div class="info-block">'+tutoresHtml+'</div>';
}
function infoBlock(label,val){ return '<div class="info-block"><div class="il">'+label+'</div><div class="iv">'+val+'</div></div>'; }

function toggleTask(petId,ref){
  var p=petById(petId);
  if(ref.indexOf("comida")===0){
    var ci=parseInt(ref.replace("comida",""),10);
    var c=p.comidas[ci];
    c.done=!c.done; c.at=c.done?AGORA:null; c.by=c.done?CUIDADOR:null;
    if(c.done) toast("Alimentação registrada · por "+CUIDADOR);
  } else if(ref.indexOf("med")===0){
    var i=parseInt(ref.replace("med",""),10);
    var m=p.meds[i];
    m.done=!m.done; m.at=m.done?AGORA:null; m.by=m.done?CUIDADOR:null;
    if(m.done) toast("Dose confirmada · por "+CUIDADOR);
  }
  render();
}

/* ---- Cadastro ---- */
function renderCadastro(){
  var f=state.form;
  var cor = f.reativo?"r":((f.med||f.dieta)?"a":"g");
  var corVar = cor==="r"?"var(--red)":cor==="a"?"var(--amber)":"var(--green)";

  var dietaHorasHtml = f.dietaHoras.map(function(h,i){
    var rem = f.dietaHoras.length>1 ? '<button class="hora-remove" onclick="removeDietaHora('+i+')" title="Remover horário">&times;</button>' : '';
    return '<div class="hora-row"><input type="time" id="f_dietaHora_'+i+'" value="'+h+'">'+rem+'</div>';
  }).join("");
  var dietaFields = f.dieta ? '<div class="nested">'
    +'<div class="row2"><div class="field"><label>Ração</label><input type="text" id="f_dietaRacao" value="'+esc(f.dietaRacao)+'" placeholder="Ex.: Ração sem grãos"></div>'
    +'<div class="field"><label>Porção</label><input type="text" id="f_dietaPorcao" value="'+esc(f.dietaPorcao)+'" placeholder="Ex.: 200g"></div></div>'
    +'<div class="field"><label>Horários das refeições</label>'+dietaHorasHtml
    +'<button class="add-hora" onclick="addDietaHora()">'+IC.plus+' Horário</button></div></div>' : '';

  var medHorasHtml = f.medHoras.map(function(h,i){
    var rem = f.medHoras.length>1 ? '<button class="hora-remove" onclick="removeMedHora('+i+')" title="Remover horário">&times;</button>' : '';
    return '<div class="hora-row"><input type="time" id="f_medHora_'+i+'" value="'+h+'">'+rem+'</div>';
  }).join("");
  var medFields = f.med ? '<div class="nested">'
    +'<div class="field"><label>Medicamento</label><input type="text" id="f_medNome" value="'+esc(f.medNome)+'" placeholder="Ex.: Apoquel 5mg"></div>'
    +'<div class="field"><label>Dose</label><input type="text" id="f_medDose" value="'+esc(f.medDose)+'" placeholder="Ex.: 1 comprimido"></div>'
    +'<div class="field"><label>Horários das doses</label>'+medHorasHtml
    +'<button class="add-hora" onclick="addMedHora()">'+IC.plus+' Horário</button></div></div>' : '';

  var reativoFields = f.reativo ? '<div class="nested">'
    +'<div class="field"><label>Observações de manejo</label><input type="text" id="f_reativoObs" value="'+esc(f.reativoObs)+'" placeholder="Ex.: isolar do grupo · guia curta"></div></div>' : '';

  var tutoresHtml = f.tutores.map(function(t,i){
    var rem = f.tutores.length>1 ? '<button class="tutor-remove" onclick="removeTutor('+i+')">Remover</button>' : '';
    return '<div class="nested">'
      +'<div class="tutor-card-head"><span class="tutor-idx">Tutor '+(i+1)+(i===0?' · emergência':'')+'</span>'+rem+'</div>'
      +'<div class="field"><label>Nome</label><input type="text" id="f_tutor_nome_'+i+'" value="'+esc(t.nome)+'" placeholder="Nome do tutor"></div>'
      +'<div class="row2"><div class="field"><label>Relação</label><input type="text" id="f_tutor_rel_'+i+'" value="'+esc(t.rel)+'" placeholder="Ex.: Tutora"></div>'
      +'<div class="field"><label>Telefone</label><input type="tel" id="f_tutor_tel_'+i+'" value="'+esc(t.tel)+'" placeholder="11 90000-0000"></div></div>'
      +'</div>';
  }).join("");

  return '<button class="back" onclick="nav(\'home\')">'+IC.back+' Cancelar</button>'
    +'<h1>Novo pet</h1><div class="sub" style="margin-top:4px;margin-bottom:20px">A coleira é derivada do que você preenche.</div>'
    +'<div class="field"><label>Nome</label><input type="text" placeholder="Ex.: Rex" id="f_nome" value="'+f.nome+'"></div>'
    +'<div class="row2"><div class="field"><label>Raça</label><input type="text" id="f_raca" value="'+f.raca+'" placeholder="Ex.: Labrador"></div>'
    +'<div class="field"><label>Idade</label><input type="text" id="f_idade" value="'+f.idade+'" placeholder="Ex.: 3 anos"></div></div>'
    +'<div class="section-t">Tutores · contatos</div>'+tutoresHtml
    +'<button class="add-btn" onclick="addTutor()">'+IC.plus+' Adicionar tutor</button>'
    +'<div class="section-t">Apontamentos de cuidado</div>'
    +toggleRow("dieta","Dieta específica","ração, porção e horários")+dietaFields
    +toggleRow("med","Medicação","remédios com horários — disparam alerta")+medFields
    +toggleRow("reativo","Reativo / agressivo","coleira vermelha · isolamento")+reativoFields
    +'<div class="collar-preview"><div class="big-puck" style="background:'+corVar+'"></div>'
    +'<div><div class="cpt">Coleira prevista</div><div class="cpv" style="color:'+corVar+'">'+nomeCor(cor).toUpperCase()+'</div></div></div>'
    +'<button class="btn-primary" onclick="salvarPet()">Salvar prontuário</button>';
}
function toggleRow(key,title,desc){
  var on=state.form[key]?" on":"";
  return '<div class="toggle-row"><div><div class="tt">'+title+'</div><div class="td">'+desc+'</div></div>'
    +'<div class="switch'+on+'" onclick="toggleForm(\''+key+'\')"></div></div>';
}
function esc(s){ return (s||"").replace(/"/g,"&quot;"); }
function captureForm(){
  var f=state.form;
  var map={f_nome:"nome",f_raca:"raca",f_idade:"idade",
    f_dietaRacao:"dietaRacao",f_dietaPorcao:"dietaPorcao",f_medNome:"medNome",f_medDose:"medDose",f_reativoObs:"reativoObs"};
  Object.keys(map).forEach(function(id){ var e=document.getElementById(id); if(e) f[map[id]]=e.value; });
  (f.tutores||[]).forEach(function(t,i){
    var n=document.getElementById("f_tutor_nome_"+i); if(n) t.nome=n.value;
    var r=document.getElementById("f_tutor_rel_"+i); if(r) t.rel=r.value;
    var te=document.getElementById("f_tutor_tel_"+i); if(te) t.tel=te.value;
  });
  (f.dietaHoras||[]).forEach(function(h,i){ var e=document.getElementById("f_dietaHora_"+i); if(e) f.dietaHoras[i]=e.value; });
  (f.medHoras||[]).forEach(function(h,i){ var e=document.getElementById("f_medHora_"+i); if(e) f.medHoras[i]=e.value; });
}
function addTutor(){ captureForm(); state.form.tutores.push({nome:"",rel:"",tel:""}); render(); }
function removeTutor(i){ captureForm(); state.form.tutores.splice(i,1); render(); }
function addDietaHora(){ captureForm(); state.form.dietaHoras.push("12:00"); render(); }
function removeDietaHora(i){ captureForm(); state.form.dietaHoras.splice(i,1); render(); }
function addMedHora(){ captureForm(); state.form.medHoras.push("14:00"); render(); }
function removeMedHora(i){ captureForm(); state.form.medHoras.splice(i,1); render(); }
function resetForm(){ state.form={ dieta:false,med:false,reativo:false,nome:"",raca:"",idade:"",
  tutores:[{nome:"",rel:"",tel:""}],
  dietaRacao:"",dietaPorcao:"",dietaHoras:["12:00"],medNome:"",medDose:"",medHoras:["14:00"],reativoObs:"" }; }
function openCadastro(){ resetForm(); nav("cadastro"); }
function toggleForm(key){ captureForm(); state.form[key]=!state.form[key]; render(); }
function salvarPet(){
  captureForm();
  var f=state.form;
  var nome=f.nome||"Novo pet";
  var raca=[f.raca,f.idade].filter(Boolean).join(" · ")||"Cadastrado agora";
  var dietaRacao=f.dieta ? (f.dietaRacao||"Ração") : null;
  var dietaPorcao=f.dieta ? (f.dietaPorcao||"") : null;
  var comidas=f.dieta ? f.dietaHoras.map(function(h){return C(h);}) : [];
  var meds=f.med ? f.medHoras.map(function(h){return M(f.medNome||"Medicação", f.medDose||"1 dose", h);}) : [];
  var tutores=(f.tutores||[]).filter(function(t){return t.nome && t.nome.trim();})
    .map(function(t,i){ return {nome:t.nome, rel:t.rel||"Tutor(a)", emerg:i===0, tel:t.tel||"11 90000-0000"}; });
  if(!tutores.length) tutores=[{nome:"Tutor cadastrado", rel:"Tutor", emerg:true, tel:"11 90000-0000"}];
  var novo={ id:"p"+Date.now(), nome:nome, emoji:"🐕", raca:raca, present:false,
    reativo:f.reativo, dietaRacao:dietaRacao, dietaPorcao:dietaPorcao, comidas:comidas, alergia:null, meds:meds,
    obs:f.reativoObs||"Reativo · isolar do grupo", tutores:tutores };
  pets.push(novo);
  resetForm();
  toast(nome+" cadastrado · coleira "+nomeCor(corDoPet(novo)));
  nav("checkin");
}

/* ---- Check-in ---- */
function renderCheckin(){
  var ausentes=pets.filter(function(p){return !p.present;});
  var lista="";
  if(ausentes.length===0){
    lista='<div class="empty">Todos os pets já estão presentes hoje.</div>';
  } else {
    ausentes.forEach(function(p){
      var c=corDoPet(p);
      lista+='<div class="pet-card '+c+'" onclick="startCheckin(\''+p.id+'\')">'
        +'<div class="av">'+p.emoji+'</div>'
        +'<div><div class="pn">'+p.nome+'</div><div class="pi">'+subtituloPet(p)+'</div></div>'
        +'<div class="right"><span class="badge '+c+'">'+nomeCor(c)+'</span></div></div>';
    });
  }
  return '<div class="eyebrow">Check-in</div><h1 style="margin-top:6px">Quem chegou?</h1>'
    +'<div class="sub" style="margin-top:4px">Selecione o pet para registrar a entrada.</div>'
    +'<div class="checkin-pick">'+lista+'</div>';
}
function startCheckin(id){ state.checkinPet=id; nav("checkin-confirm"); }

function renderCheckinConfirm(){
  var p=petById(state.checkinPet);
  var c=corDoPet(p);
  var corVar = c==="r"?"var(--red)":c==="a"?"var(--amber)":"var(--green)";
  var reforco = p.reativo ? '<div class="appt" style="background:var(--red-tint);border-color:var(--red)">⚠️ '+ (p.obs||"Isolar do grupo") +'</div>' : "";
  var apont = subtituloPet(p);
  return '<button class="back" onclick="nav(\'checkin\')">'+IC.back+' Voltar</button>'
    +'<div class="instruct">'
    +'<div class="big-collar" style="background:'+corVar+'">'+IC.paw+'</div>'
    +'<div class="il1">Registrando a chegada de</div>'
    +'<div class="il2">Coleira <span class="cc" style="color:'+corVar+'">'+nomeCor(c).toUpperCase()+'</span></div>'
    +'<div class="il1">em <b>'+p.nome+'</b></div>'
    +'<div class="appt">'+apont+'</div>'+reforco
    +'<button class="btn-primary" onclick="confirmCheckin(\''+p.id+'\')">Confirmar presença</button>'
    +'</div>';
}
function confirmCheckin(id){
  var p=petById(id); p.present=true;
  toast(p.nome+" está presente");
  nav("home");
}

/* ---- Alerta de medicação ---- */
function fireAlert(){
  // encontra a primeira medicação pendente de um pet presente
  var alvo=null;
  pets.filter(function(p){return p.present;}).forEach(function(p){
    (p.meds||[]).forEach(function(m,i){ if(!m.done && !alvo) alvo={p:p,m:m,i:i}; });
  });
  if(!alvo){ toast("Nenhuma medicação pendente 🎉"); return; }
  var p=alvo.p, m=alvo.m;
  var ov=document.getElementById("overlay");
  ov.innerHTML='<div class="alert-sheet"><div class="grip"></div>'
    +'<div class="alert-icon">'+IC.alert+'</div>'
    +'<h2>Hora do remédio</h2><div class="asub">'+p.nome+' precisa da medicação agora</div>'
    +'<div class="alert-detail"><div class="amed">'+m.nome+'</div><div class="adose">'+m.dose+'</div>'
    +'<div class="atime">'+IC.clock+' agendado '+m.hora+' · registra quem e quando</div></div>'
    +'<button class="btn-primary" onclick="confirmDose(\''+p.id+'\','+alvo.i+')">Confirmar dose</button>'
    +'<button class="btn-secondary" onclick="snoozeDose()">Adiar 5 min</button></div>';
  ov.classList.add("show");
}
function confirmDose(petId,i){
  var p=petById(petId); var m=p.meds[i];
  m.done=true; m.at=AGORA; m.by=CUIDADOR;
  closeOverlay();
  updateBellDot();
  toast("Dose de "+p.nome+" confirmada · por "+CUIDADOR);
  render();
}
function snoozeDose(){
  closeOverlay();
  toast("Adiado 5 min — o alerta vai reaparecer");
}
function closeOverlay(){ var ov=document.getElementById("overlay"); ov.classList.remove("show"); ov.innerHTML=""; }
document.getElementById("overlay").addEventListener("click",function(e){ if(e.target===this) closeOverlay(); });

function updateBellDot(){
  var pend=false;
  pets.filter(function(p){return p.present;}).forEach(function(p){ (p.meds||[]).forEach(function(m){ if(!m.done) pend=true; }); });
  document.getElementById("bellDot").style.display=pend?"block":"none";
}

/* ---- Toast ---- */
var toastTimer;
function toast(msg){
  var t=document.getElementById("toast");
  t.innerHTML=IC.check+" "+msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer=setTimeout(function(){t.classList.remove("show");},2600);
}

/* ---- Nav bar ---- */
function renderNav(){
  var nb=document.getElementById("navbar");
  var homeActive=(state.screen==="home"||state.screen==="detail")?" active":"";
  var addActive=(state.screen==="cadastro")?" active":"";
  var ciActive=(state.screen==="checkin"||state.screen==="checkin-confirm")?" active":"";
  nb.innerHTML=
    '<button class="nav-item'+addActive+'" onclick="openCadastro()">'+IC.plus+'<span>Novo</span></button>'
    +'<button class="nav-item nav-center" onclick="nav(\'home\')"><span class="circle">'+IC.home+'</span><span class="lbl">Hoje</span></button>'
    +'<button class="nav-item'+ciActive+'" onclick="nav(\'checkin\')">'+IC.checkin+'<span>Check-in</span></button>';
}

/* ---- Init ---- */
render();
updateBellDot();
</script>
</body>
</html>
